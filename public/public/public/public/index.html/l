<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#102c25">
<title>Reinicio: PC en apuros</title>
<style>
:root{--bg:#102c25;--panel:#f2f5ec;--ink:#132b24;--mint:#8de3bd;--lime:#d8f178;--line:#ffffff24;--green:#347750;--shadow:0 22px 60px #0004}
*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 10% 0%,#5cac892b,transparent 36%),radial-gradient(ellipse at 95% 90%,#b7cf6420,transparent 35%),var(--bg);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:#f5f7ef}
button,input{font:inherit}button{cursor:pointer}button:disabled{cursor:default;opacity:.5}
.wrap{width:min(100% - 26px,900px);min-height:100vh;margin:auto;display:flex;flex-direction:column}
header{height:68px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}
.brand{display:flex;align-items:center;gap:10px;font-size:11px;font-weight:850;letter-spacing:.15em;text-transform:uppercase}.mark{width:35px;height:35px;border:1px solid #8de3bd88;border-radius:11px;color:var(--mint);display:grid;place-items:center;letter-spacing:-.06em}
.signal{font-size:11px;color:#acc0b0}.signal i{display:inline-block;width:7px;height:7px;background:#8de3bd;border-radius:50%;margin-right:7px}
main{flex:1;display:grid;place-items:center;padding:26px 0 35px}.screen{width:100%;animation:appear .25s ease both}@keyframes appear{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.hero{text-align:center;max-width:630px;margin:0 auto 23px}.eyebrow,.small-label{color:var(--mint);text-transform:uppercase;letter-spacing:.17em;font-size:10px;font-weight:850}
h1{font-size:clamp(39px,8vw,66px);line-height:.98;letter-spacing:-.06em;margin:17px 0 13px}h1 span{color:var(--mint)}h2{font-size:clamp(25px,4vw,35px);line-height:1.16;letter-spacing:-.04em;margin:0 0 9px}h3{margin:0}
.lead{color:#cfddd2;line-height:1.6;font-size:14px;margin:0 auto;max-width:535px}
.panels{display:grid;grid-template-columns:1fr 1fr;gap:13px}.panel,.card,.result{background:var(--panel);color:var(--ink);border-radius:18px;padding:22px;box-shadow:var(--shadow)}
.panel h2{font-size:17px;letter-spacing:-.02em;margin:0 0 7px}.muted{color:#66796d;font-size:12px;line-height:1.5;margin:0 0 15px}
.primary{border:0;border-radius:11px;padding:13px 16px;background:var(--lime);color:#203528;font-weight:850}.primary:hover:not(:disabled){filter:brightness(1.04);transform:translateY(-1px)}
.secondary{border:1px solid #ffffff42;background:#ffffff0c;color:#f4f8ef;border-radius:10px;padding:10px 13px;font-weight:750}
.light{border:1px solid #d3ded2;background:#fff;color:#21412f;border-radius:10px;padding:12px;font-weight:800}
form{display:grid;gap:9px}input{width:100%;border:1px solid #d4ded4;border-radius:10px;background:#fff;color:var(--ink);padding:12px;outline:none}
input:focus{border-color:#58a879;box-shadow:0 0 0 3px #58a87920}.code-input{font-size:21px;letter-spacing:.17em;font-weight:850}
.note{text-align:center;color:#9fb4a4;font-size:10px;line-height:1.55;margin:15px auto 0;max-width:620px}.error{padding:11px 13px;background:#ffefeb;color:#8b4032;border-radius:10px;font-size:12px;line-height:1.45;margin-top:13px}
.card{padding:clamp(21px,4vw,32px);border-radius:20px}.room-head,.q-meta,.round-head{display:flex;align-items:center;justify-content:space-between;gap:12px}
.tag{border-radius:999px;background:#e1eee2;color:#4d7258;padding:7px 10px;font-size:10px;letter-spacing:.1em;text-transform:uppercase;font-weight:850}
.pin{font-size:clamp(53px,12vw,83px);font-variant-numeric:tabular-nums;font-weight:900;letter-spacing:.16em;text-align:center;color:#173d2c;padding:16px 0 7px}
.invite{text-align:center;background:#f8faf5;border:1px dashed #a8c0ad;border-radius:13px;padding:13px;margin:6px 0 17px}.invite p{font-size:11px;color:#61766a;margin:0 0 7px}.linkline{display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;font-size:13px;font-weight:800;color:#246044;overflow-wrap:anywhere}.copy{border:1px solid #cfddce;background:#fff;color:#42664d;border-radius:8px;padding:5px 9px;font-size:10px;font-weight:800}
.list{display:grid;grid-template-columns:repeat(auto-fit,minmax(135px,1fr));gap:7px}.person{border:1px solid #e0e6dd;background:#fbfcf8;border-radius:10px;padding:9px 10px;display:flex;align-items:center;gap:8px;font-size:11px;font-weight:750}.avatar{width:24px;height:24px;border-radius:8px;background:#dcecdf;color:#39724d;display:grid;place-items:center;flex:none}
.row{display:flex;align-items:center;justify-content:space-between;gap:11px;margin:13px 0 9px}.count{color:#536b5b;font-weight:800;font-size:11px}.hint{font-size:10px;line-height:1.5;color:#728277}
.actions{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:18px}
.round-head{font-size:10px;color:#d0dfd2;margin-bottom:9px}.round-head b{color:var(--mint);letter-spacing:.1em;text-transform:uppercase}
.progress{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-bottom:12px}.progress span{height:4px;border-radius:8px;background:#ffffff26}.progress .done{background:var(--mint)}
.q-meta{margin-bottom:15px}.timer{display:flex;align-items:center;gap:7px;color:#436a50;font-size:11px;font-weight:850;font-variant-numeric:tabular-nums}.track{width:65px;height:5px;background:#dce5d9;border-radius:8px;overflow:hidden}.fill{height:100%;width:100%;background:#62a77f;transition:width .2s linear}
.prompt{font-size:13px;color:#596e61;line-height:1.6;margin:0}
.choices{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:17px}.choice{min-height:52px;border:1px solid #dbe3d9;border-radius:11px;background:#fbfcf8;color:var(--ink);padding:9px 11px;display:flex;align-items:center;gap:9px;text-align:left;font-size:11px;font-weight:750}
.choice:hover:not(:disabled){border-color:#7eb891;background:#eff8f0}.choice.correct,.choice.selected{border-color:#589a6e;background:#e4f2e5}.choice.wrong{border-color:#e4a192;background:#fff0ec}
.letter{width:25px;height:25px;flex:none;border-radius:8px;background:#e9efe7;color:#476650;display:grid;place-items:center;font-size:10px;font-weight:900}
.feedback{margin-top:13px;padding:12px 13px;border-radius:10px;background:#e5f2e6;color:#315f3f;font-size:11px;line-height:1.55}.feedback strong{font-weight:900}
.layout{display:grid;grid-template-columns:1.2fr .8fr;gap:12px;align-items:start}.scores{border:1px solid #ffffff16;background:#1b3d32;border-radius:15px;padding:15px}.scores-head{display:flex;align-items:center;justify-content:space-between;color:#f1f6ee;font-size:13px;font-weight:850;margin-bottom:10px}.scores-head small{font-size:9px;color:#a9bcae}.score-list{display:grid;gap:6px}.score{display:grid;grid-template-columns:24px minmax(0,1fr) auto;gap:7px;align-items:center;background:#ffffff09;border-radius:8px;padding:8px;color:#e7efe6;font-size:10px}.rank{color:#abd0ad;font-weight:900}.pname{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.pts{color:#c9eea0;font-weight:850;font-variant-numeric:tabular-nums}
.wait{text-align:center;padding:26px 10px}.wait-icon,.result-icon{width:65px;height:65px;margin:0 auto 14px;border-radius:22px;background:#dceede;color:#3b8155;display:grid;place-items:center;font-size:28px;transform:rotate(-5deg)}.wait p,.result>p{max-width:420px;margin:0 auto;color:#64776a;line-height:1.6;font-size:12px}
.result{text-align:center;max-width:620px;margin:auto}.result-icon{transform:none}.result h2{margin:10px 0}.result>p{margin-bottom:17px}.podium{max-width:440px;margin:18px auto 20px}
footer{height:46px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;color:#8da596;font-size:9px}
@media(max-width:650px){.panels,.layout{grid-template-columns:1fr}.wrap{width:min(100% - 20px,560px)}main{padding:21px 0 27px}.panel{padding:18px}.card{border-radius:17px}}
@media(max-width:420px){.choices{grid-template-columns:1fr;gap:7px;margin-top:13px}.choice{min-height:47px}.actions{align-items:stretch;flex-direction:column}.actions button{width:100%}.invite{padding:11px 8px}.track{width:48px}footer span:last-child{display:none}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
</head>
<body>
<div class="wrap">
<header><div class="brand"><span class="mark">PC</span><span>Taller de expansión</span></div><div class="signal"><i></i>Juego en grupo</div></header>
<main><div id="app" class="screen"></div></main>
<footer><span>Basado en la presentación del grupo</span><span>Reinicio: PC en apuros</span></footer>
</div>
<script>
(function(){
"use strict";
var app=document.getElementById("app"), letters=["A","B","C","D"];
var session=null, state=null, signature="", timer=null, errorText="";
var params=new URLSearchParams(location.search), inviteCode=(params.get("codigo")||params.get("code")||"").replace(/\D/g,"").slice(0,6);
function esc(v){return String(v==null?"":v).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]})}
function save(){if(session)localStorage.setItem("expansion-room",JSON.stringify(session))}
function clear(){if(timer)clearTimeout(timer);timer=null;localStorage.removeItem("expansion-room");session=null;state=null;signature=""}
async function api(url,options){var r=await fetch(url,options||{}),d={};try{d=await r.json()}catch(_){}if(!r.ok){var e=new Error(d.error||"No se pudo completar la acción.");e.status=r.status;throw e}return d}
function post(url,data){return api(url,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(data)})}
function renderHome(){
 app.innerHTML='<div class="hero"><div class="eyebrow">Cinco casos · cada quien responde en su móvil</div><h1>Reinicio:<br><span>PC en apuros</span></h1><p class="lead">Resuelve cinco incidencias del taller y consigue que el ordenador vuelva a funcionar. El grupo entra con un enlace y un código de sala.</p></div>'+
 '<div class="panels"><section class="panel"><h2>Presentador</h2><p class="muted">Crea una sala en esta página y comparte el enlace o el código con la clase.</p><button class="primary" data-action="create">Crear sala →</button></section>'+
 '<section class="panel"><h2>Jugador</h2><p class="muted">Escribe el código que aparece en la pantalla del presentador.</p><form id="join-form"><input class="code-input" id="code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="CÓDIGO" aria-label="Código de sala" value="'+esc(inviteCode)+'" required><input id="name" maxlength="18" autocomplete="nickname" placeholder="Tu nombre o apodo" aria-label="Tu nombre o apodo" required><button class="light" type="submit">Unirme a la partida →</button></form></section></div>'+
 (errorText?'<div class="error" role="alert">'+esc(errorText)+'</div>':"")+
 '<p class="note">La partida se aloja en internet: los móviles pueden usar datos o cualquier Wi-Fi. Usad apodos; solo se guardan el nombre y la puntuación mientras la sala está activa.</p>';
}
function playerCards(players,showAnswered){
 if(!players.length)return '<p class="hint">Todavía no se ha unido nadie. Comparte el enlace de la sala.</p>';
 return '<div class="list">'+players.map(function(p){return '<div class="person"><span class="avatar">'+esc((p.name||"?").slice(0,1).toUpperCase())+'</span>'+esc(p.name)+(showAnswered?'<span class="hint">'+(p.answered?"· respondió":"· esperando")+'</span>':"")+'</div>'}).join("")+'</div>';
}
function scoreList(players){
 return '<div class="score-list">'+players.map(function(p){return '<div class="score"><span class="rank">'+p.rank+'</span><span class="pname">'+esc(p.name)+(p.answered&&state.phase==="playing"?' · respondió':"")+'</span><span class="pts">'+p.score+' pts</span></div>'}).join("")+'</div>';
}
function timerHtml(id){return '<span class="timer"><span id="'+id+'">15 s</span><span class="track"><span class="fill" id="'+id+'-fill"></span></span></span>'}
function roundTop(s){var n=Math.max(1,s.questionIndex+1),bars="";for(var i=0;i<s.questionTotal;i++)bars+='<span class="'+(i<n?"done":"")+'"></span>';return '<div class="round-head"><b>Incidencia '+String(n).padStart(2,"0")+' / '+s.questionTotal+'</b><span>'+s.players.length+' jugadores</span></div><div class="progress">'+bars+'</div>'}
function questionPanel(q,locked,choice,reveal,hostView){
 var choices=q.options.map(function(text,i){var cls="choice";if(reveal&&i===q.answer)cls+=" correct";if(locked&&!reveal&&i===choice)cls+=" selected";if(reveal&&choice===i&&i!==q.answer)cls+=" wrong";var disabled=locked||reveal?" disabled":"";var action=disabled?"":' data-action="answer" data-choice="'+i+'"';return '<button class="'+cls+'"'+action+disabled+'><span class="letter">'+letters[i]+'</span><span>'+esc(text)+'</span></button>'}).join("");
 var feedback="";
 if(reveal)feedback='<div class="feedback"><strong>Respuesta: '+letters[q.answer]+'.</strong> '+esc(q.explanation)+(session.role==="player"?' <strong>Sumaste '+state.myRoundPoints+' puntos.</strong>':"")+'</div>';
 else if(locked&&!hostView)feedback='<div class="feedback"><strong>Respuesta enviada.</strong> Espera a que termine la ronda.</div>';
 return '<article class="card"><div class="q-meta"><span class="tag">'+esc(q.topic)+'</span>'+timerHtml(session.role==="host"?"host-clock":"player-clock")+'</div><h2>'+esc(q.title)+'</h2><p class="prompt">'+esc(q.prompt)+'</p><div class="choices">'+choices+'</div>'+feedback+'</article>';
}
function renderHost(){
 var s=state;
 if(s.phase==="lobby"){
  var invite=location.origin+"/?codigo="+encodeURIComponent(s.code);
  return '<section class="card"><div class="room-head"><div><div class="small-label">Sala de espera · código de acceso</div><div class="pin">'+esc(s.code)+'</div></div><span class="tag">Presentador</span></div>'+
  '<div class="invite"><p>Comparte este enlace; abre la página con el código ya preparado:</p><div class="linkline"><span>'+esc(invite)+'</span><button class="copy" data-action="copy" data-url="'+esc(invite)+'">Copiar enlace</button></div></div>'+
  '<div class="row"><h3>Jugadores conectados</h3><span class="count">'+s.playerCount+' '+(s.playerCount===1?"jugador":"jugadores")+'</span></div>'+playerCards(s.players,false)+
  '<div class="actions"><span class="hint">Los móviles pueden estar en redes distintas.</span><button class="primary" data-action="start" '+(s.playerCount?"":"disabled")+'>Empezar partida →</button></div></section>';
 }
 if(s.phase==="done")return '<section class="result"><div class="result-icon">✦</div><div class="small-label">Diagnóstico completado</div><h2>Marcador final</h2><p>La clase ha resuelto los cinco casos. ¡Buen trabajo en el taller!</p><div class="podium">'+scoreList(s.players)+'</div><button class="primary" data-action="new">Crear otra sala ↻</button></section>';
 var review=s.phase==="review",n=s.questionIndex+1,q=s.question;
 return roundTop(s)+'<div class="layout">'+questionPanel(q,true,null,review,true)+'<aside class="scores"><div class="scores-head"><span>Marcador</span><small>'+(review?"Respuesta revelada":"Respuestas: "+s.answeredCount+" / "+s.playerCount)+'</small></div>'+scoreList(s.players)+'</aside></div>'+
 '<div class="actions"><span class="hint">'+(review?"El acierto rápido suma más puntos.":"Tienen 15 segundos para responder.")+'</span>'+(review?'<button class="primary" data-action="next">'+(n>=s.questionTotal?"Ver resultado final":"Siguiente caso →")+'</button>':'<button class="primary" disabled>Ronda en curso…</button>')+'</div>';
}
function renderPlayer(){
 var s=state;
 if(s.phase==="lobby")return '<section class="card wait"><div class="wait-icon">⌁</div><div class="small-label">Conectado a la sala '+esc(s.code)+'</div><h2>¡Hola, '+esc(session.name)+'!</h2><p>Espera a que el presentador empiece. La pregunta aparecerá aquí y podrás responder desde tu móvil.</p></section>';
 var me=s.players.find(function(p){return p.id===session.playerId});
 if(s.phase==="done")return '<section class="result"><div class="result-icon">'+(s.myRank===1?"✦":"✓")+'</div><div class="small-label">Partida terminada · puesto '+s.myRank+' de '+s.playerCount+'</div><h2>¡Buen trabajo, '+esc(session.name)+'!</h2><p>Tu puntuación final: <strong>'+(me?me.score:0)+' puntos</strong>.</p><div class="podium">'+scoreList(s.players)+'</div><button class="secondary" data-action="home">Salir de la sala</button></section>';
 var locked=s.myAnswer!==null&&s.myAnswer!==undefined,review=s.phase==="review";
 return roundTop(s)+questionPanel(s.question,locked,s.myAnswer,review)+'<section class="scores"><div class="scores-head"><span>Tu partida</span><small>'+esc(session.name)+' · puesto '+(s.myRank||"—")+'</small></div><div class="score"><span class="rank">★</span><span class="pname">'+(review?"Ronda cerrada":"Responde antes de que termine el tiempo")+'</span><span class="pts">'+(me?me.score:0)+' pts</span></div></section>';
}
function render(){
 if(!session){renderHome();return}
 if(!state){app.innerHTML='<section class="card wait"><div class="wait-icon">⌁</div><h2>Conectando…</h2><p>Estamos recuperando la sala.</p></section>';return}
 app.innerHTML=session.role==="host"?renderHost():renderPlayer();updateClock();
}
function updateClock(){
 if(!state||state.phase!=="playing"||!state.deadline)return;
 var left=Math.max(0,state.deadline-Date.now()),seconds=Math.ceil(left/1000);
 ["host-clock","player-clock"].forEach(function(id){var t=document.getElementById(id),f=document.getElementById(id+"-fill");if(t)t.textContent=seconds+" s";if(f)f.style.width=Math.max(0,left/150)+"%"});
}
function stateParams(){
 var p=new URLSearchParams({code:session.code,role:session.role});
 if(session.role==="host")p.set("key",session.key);else p.set("playerId",session.playerId);
 return p.toString();
}
async function poll(){
 if(!session)return;
 var thisSession=session;
 try{
  var next=await api("/api/state?"+stateParams());
  if(session!==thisSession)return;
  state=next;var sig=JSON.stringify(next);
  if(sig!==signature){signature=sig;render()}else updateClock();
 }catch(err){
  if(session!==thisSession)return;
  if(err.status===403||err.status===404){clear();errorText=err.message;renderHome();return}
 }
 if(session===thisSession)timer=setTimeout(poll,650);
}
function beginPolling(){if(timer)clearTimeout(timer);poll()}
async function createRoom(){
 errorText="";
 try{var d=await post("/api/host",{});session={role:"host",code:d.code,key:d.key};save();state=null;signature="";beginPolling()}
 catch(e){errorText=e.message;renderHome()}
}
async function joinRoom(code,name){
 errorText="";
 try{var d=await post("/api/join",{code:code,name:name});session={role:"player",code:d.code,playerId:d.playerId,name:d.name};save();state=null;signature="";beginPolling()}
 catch(e){errorText=e.message;renderHome()}
}
async function hostPost(path){
 try{await post(path,{code:session.code,key:session.key});signature="";await poll()}
 catch(e){errorText=e.message;render()}
}
async function answer(choice){
 if(!session||session.role!=="player"||!state||state.phase!=="playing"||state.myAnswer!==null&&state.myAnswer!==undefined)return;
 try{await post("/api/answer",{code:session.code,playerId:session.playerId,choice:Number(choice)});signature="";await poll()}
 catch(e){if(e.status===409){signature="";await poll()}else{errorText=e.message;render()}}
}
app.addEventListener("click",function(event){
 var b=event.target.closest("[data-action]");if(!b)return;var a=b.getAttribute("data-action");
 if(a==="create"){createRoom();return}
 if(a==="start"){hostPost("/api/start");return}
 if(a==="next"){hostPost("/api/next");return}
 if(a==="answer"){answer(b.getAttribute("data-choice"));return}
 if(a==="home"){clear();errorText="";renderHome();return}
 if(a==="new"){clear();createRoom();return}
 if(a==="copy"){
  var text=b.getAttribute("data-url");
  if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(text).then(function(){b.textContent="Copiado"}).catch(function(){window.prompt("Copia este enlace para compartirlo:",text)});
  else window.prompt("Copia este enlace para compartirlo:",text);
 }
});
app.addEventListener("submit",function(event){
 if(event.target&&event.target.id==="join-form"){event.preventDefault();joinRoom(document.getElementById("code").value,document.getElementById("name").value)}
});
document.addEventListener("keydown",function(event){
 if(session&&session.role==="player"&&state&&state.phase==="playing"&&["1","2","3","4"].indexOf(event.key)>=0)answer(Number(event.key)-1);
});
function init(){
 var saved=null;try{saved=JSON.parse(localStorage.getItem("expansion-room")||"null")}catch(_){}
 if(saved&&saved.code&&saved.role){session=saved;beginPolling()}else renderHome();
}
init();
})();
</script>
</body>
</html>
